# Copy to .env.local (and set the same values in Vercel). Never commit real values.

# Meta WhatsApp Cloud API (WhatsApp → API Setup in the Meta app dashboard)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=        # any string we choose; must match Meta's webhook config
WHATSAPP_GRAPH_VERSION=       # e.g. v23.0, as shown on Meta's API Setup page

# Anthropic (server-side only)
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # server only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Link sent in the approval message
RESOURCES_LINK=

# Optional: IANA time zone that "today" resolves to (default UTC), e.g. America/Los_Angeles
APP_TIME_ZONE=
